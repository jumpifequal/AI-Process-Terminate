#include <winver.h>

// ---------------------------------------------------------------------------
// Application icon
// ---------------------------------------------------------------------------
#define IDI_APP_ICON 101
IDI_APP_ICON ICON "AIProcess-Terminate.ico"

// ---------------------------------------------------------------------------
// Application manifest  (type 24 = RT_MANIFEST, ID 1 = EXE manifest)
// ---------------------------------------------------------------------------
1 24 "AIProcess-Terminate.manifest"

// ---------------------------------------------------------------------------
// Version information
// ---------------------------------------------------------------------------
#define VER_MAJOR       2
#define VER_MINOR       0
#define VER_PATCH       1
#define VER_BUILD       0
#define VER_STR         "2.0.1.0\0"
#define PRODUCT_STR     "2.0.1.0\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"    // English (US) + Unicode
        BEGIN
            VALUE "FileDescription",  "AI Process-Terminate\0"
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "AIProcess-Terminate\0"
            VALUE "LegalCopyright",   "\0"
            VALUE "OriginalFilename", "AIProcess-Terminate.exe\0"
            VALUE "ProductName",      "AI Process-Terminate\0"
            VALUE "ProductVersion",   PRODUCT_STR
            VALUE "Comments",         "Terminates desktop AI assistant processes in one shot.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200   // English (US), Unicode
    END
END
